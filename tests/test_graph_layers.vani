use "../src/lib.vani";
use "../vendor/calculus/src/lib.vani";

// v0.4.0: activations (Relu/Sigmoid/Tanh), Log, and the composed
// dense/MSE/binary-cross-entropy helpers. Same finite-difference
// cross-check discipline as tests/test_graph_core.vani (v0.3.0) --
// every gradient is validated against calculus::diff_central, not just
// "looks right" from reading the backward rule.

#[test]
fn test_graph_relu_gradient_positive_branch() -> i64 {
    let arena: Vec<GraphNode> = graph_arena_new();
    let x: i64 = graph_param(mut ref arena, 3.0);
    let root: i64 = graph_relu(mut ref arena, x);

    let values: Vec<f64> = graph_forward(ref arena);
    assert abs(values[root] - 3.0) < 1.0e-9;

    let grads: Vec<f64> = graph_backward(ref arena, ref values, root);
    assert abs(grads[x] - 1.0) < 1.0e-9;

    let h: f64 = 1.0e-5;
    let _s1: i64 = graph_set_value(mut ref arena, x, 3.0 + h);
    let vph: Vec<f64> = graph_forward(ref arena);
    let _s2: i64 = graph_set_value(mut ref arena, x, 3.0 - h);
    let vmh: Vec<f64> = graph_forward(ref arena);
    let numeric_dx: f64 = calculus::diff_central(vmh[root], vph[root], h);
    assert abs(grads[x] - numeric_dx) < 1.0e-6;
    return 0;
}

#[test]
fn test_graph_relu_gradient_negative_branch() -> i64 {
    let arena: Vec<GraphNode> = graph_arena_new();
    let x: i64 = graph_param(mut ref arena, 0.0 - 3.0);
    let root: i64 = graph_relu(mut ref arena, x);

    let values: Vec<f64> = graph_forward(ref arena);
    assert abs(values[root] - 0.0) < 1.0e-9;

    let grads: Vec<f64> = graph_backward(ref arena, ref values, root);
    assert abs(grads[x] - 0.0) < 1.0e-9;

    let h: f64 = 1.0e-5;
    let _s1: i64 = graph_set_value(mut ref arena, x, (0.0 - 3.0) + h);
    let vph: Vec<f64> = graph_forward(ref arena);
    let _s2: i64 = graph_set_value(mut ref arena, x, (0.0 - 3.0) - h);
    let vmh: Vec<f64> = graph_forward(ref arena);
    let numeric_dx: f64 = calculus::diff_central(vmh[root], vph[root], h);
    assert abs(grads[x] - numeric_dx) < 1.0e-6;
    return 0;
}

