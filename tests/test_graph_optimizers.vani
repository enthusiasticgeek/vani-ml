use "../src/lib.vani";

// v0.5.0: SGD/Momentum/Adam over the graph's parameter vector. Two
// kinds of test per optimizer: a hand-computed single-step exactness
// check (using a FABRICATED grads Vec, not one derived from
// graph_backward -- isolates the optimizer's own arithmetic from
// autodiff correctness, which tests/test_graph_core.vani and
// tests/test_graph_layers.vani already cover separately), and a
// convergence check (minimizing a real MSE loss over many iterations,
// the actual point of having an optimizer at all).

#[test]
fn test_graph_sgd_step_hand_computed() -> i64 {
    let arena: Vec<GraphNode> = graph_arena_new();
    let x: i64 = graph_param(mut ref arena, 5.0);
    let grads: Vec<f64> = vec(2.0);
    let params: Vec<i64> = vec(x);
    let _s: i64 = graph_sgd_step(mut ref arena, ref params, ref grads, 0.1);
    let values: Vec<f64> = graph_forward(ref arena);
    // 5.0 - 0.1*2.0 = 4.8
    assert abs(values[x] - 4.8) < 1.0e-9;
    return 0;
}

#[test]
fn test_graph_momentum_step_hand_computed() -> i64 {
    let arena: Vec<GraphNode> = graph_arena_new();
    let x: i64 = graph_param(mut ref arena, 5.0);
    let grads: Vec<f64> = vec(2.0);
    let params: Vec<i64> = vec(x);
    let state0: MomentumState = momentum_state_new(1);
    let state1: MomentumState = graph_momentum_step(mut ref arena, ref params, ref grads, ref state0, 0.1, 0.9);
    // v = 0.9*0 - 0.1*2.0 = -0.2; param = 5.0 + (-0.2) = 4.8
    assert abs(state1.velocity[0] - (0.0 - 0.2)) < 1.0e-9;
    let values: Vec<f64> = graph_forward(ref arena);
    assert abs(values[x] - 4.8) < 1.0e-9;
    return 0;
}

#[test]
fn test_graph_adam_step_hand_computed() -> i64 {
    let arena: Vec<GraphNode> = graph_arena_new();
    let x: i64 = graph_param(mut ref arena, 5.0);
    let grads: Vec<f64> = vec(2.0);
    let params: Vec<i64> = vec(x);
    let state0: AdamState = adam_state_new(1);
    let state1: AdamState = graph_adam_step(mut ref arena, ref params, ref grads, ref state0, 0.1, 0.9, 0.999, 1.0e-8);
    assert state1.t == 1;
    // m = 0.9*0 + 0.1*2.0 = 0.2; v = 0.999*0 + 0.001*4.0 = 0.004
    assert abs(state1.m[0] - 0.2) < 1.0e-9;
    assert abs(state1.v[0] - 0.004) < 1.0e-9;
    // m_hat = 0.2/(1-0.9) = 2.0; v_hat = 0.004/(1-0.999) = 4.0
    // update = 0.1 * 2.0/(sqrt(4.0)+eps) ~= 0.1; param ~= 5.0 - 0.1 = 4.9
    let values: Vec<f64> = graph_forward(ref arena);
    assert abs(values[x] - 4.9) < 1.0e-4;
    return 0;
}

// Minimizes f(x) = (x - 3)^2 (via graph_mse_loss with a single
// prediction/target pair) starting from x=0 -- the actual point of an
// optimizer, not just correct single-step arithmetic. Convergence
// factor for plain SGD here is |1 - 2*lr| = |1 - 0.6| = 0.4 per step,
// so 200 iterations converges far tighter than the assert needs.
#[test]
fn test_graph_sgd_minimizes_quadratic() -> i64 {
    let arena: Vec<GraphNode> = graph_arena_new();
    let x: i64 = graph_param(mut ref arena, 0.0);
    let preds: Vec<i64> = vec(x);
    let targets: Vec<f64> = vec(3.0);
    let loss: i64 = graph_mse_loss(mut ref arena, ref preds, ref targets);
    let params: Vec<i64> = vec(x);

    let iter: i64 = 0;
    while iter < 200 {
        let values: Vec<f64> = graph_forward(ref arena);
        let grads: Vec<f64> = graph_backward(ref arena, ref values, loss);
        let _s: i64 = graph_sgd_step(mut ref arena, ref params, ref grads, 0.3);
        iter = iter + 1;
    }
    let final_values: Vec<f64> = graph_forward(ref arena);
    assert abs(final_values[x] - 3.0) < 1.0e-3;
    return 0;
}

#[test]
fn test_graph_momentum_minimizes_quadratic() -> i64 {
    let arena: Vec<GraphNode> = graph_arena_new();
    let x: i64 = graph_param(mut ref arena, 0.0);
    let preds: Vec<i64> = vec(x);
    let targets: Vec<f64> = vec(3.0);
    let loss: i64 = graph_mse_loss(mut ref arena, ref preds, ref targets);
    let params: Vec<i64> = vec(x);
    let state: MomentumState = momentum_state_new(1);

    let iter: i64 = 0;
    while iter < 300 {
        let values: Vec<f64> = graph_forward(ref arena);
        let grads: Vec<f64> = graph_backward(ref arena, ref values, loss);
        state = graph_momentum_step(mut ref arena, ref params, ref grads, ref state, 0.05, 0.9);
        iter = iter + 1;
    }
    let final_values: Vec<f64> = graph_forward(ref arena);
    assert abs(final_values[x] - 3.0) < 1.0e-3;
    return 0;
}

#[test]
fn test_graph_adam_minimizes_quadratic() -> i64 {
    let arena: Vec<GraphNode> = graph_arena_new();
    let x: i64 = graph_param(mut ref arena, 0.0);
    let preds: Vec<i64> = vec(x);
    let targets: Vec<f64> = vec(3.0);
    let loss: i64 = graph_mse_loss(mut ref arena, ref preds, ref targets);
    let params: Vec<i64> = vec(x);
    let state: AdamState = adam_state_new(1);

    let iter: i64 = 0;
    while iter < 300 {
        let values: Vec<f64> = graph_forward(ref arena);
        let grads: Vec<f64> = graph_backward(ref arena, ref values, loss);
        state = graph_adam_step(mut ref arena, ref params, ref grads, ref state, 0.1, 0.9, 0.999, 1.0e-8);
        iter = iter + 1;
    }
    let final_values: Vec<f64> = graph_forward(ref arena);
    assert abs(final_values[x] - 3.0) < 1.0e-3;
    return 0;
}

fn main() -> i64 { return 0; }
