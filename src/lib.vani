// vani-ml — machine learning for vāṇी
//
// See TODO.md for the phase checklist and kosh-index/ROADMAP.md's
// "vani-ml scoping breakdown" for full scope, architecture decisions,
// and per-phase risk notes.
//
// Staged: classical ML (v0.1.0-v0.2.0) first, then an autodiff/neural-net
// engine (v0.3.0+) built on a flat arena (Vec<Node> + i64 child indices),
// the same pattern vani-symbolic uses for its expression tree -- refs are
// passed as explicit mut ref Vec<f64> arguments through the backward pass,
// never captured by a closure (ref-capturing closures are compiler
// path-D, deferred indefinitely; see README.md for the full writeup).
//
// CONVENTION: every X_flat is row-major n_obs x n_pred (or n_obs x n_dim
// for kmeans), matching vani-matrix/vani-probability/vani-tensor's shared
// layout -- row i, column j lives at X_flat[i * n_pred + j].
//
// IMPORTANT -- do NOT reimplement vāṇी compiler builtins already used
// throughout this file: push len vec sqrt exp log f64_sigmoid abs
// seed_rng rand_in_range rand_in_range_f64 vec_swap vec_mean

// ── Linear regression ────────────────────────────────────────────────────
// Thin wrappers over vani-probability's MLR (ordinary least squares via
// normal equations, probability::mlr_*). probability::mlr_fit's own
// convention is "include an intercept column of 1s yourself if you want
// one" -- linreg_add_intercept below is the one genuinely new piece here,
// removing that boilerplate.

// Prepends a column of 1s to X_flat (n_obs x n_pred -> n_obs x (n_pred+1),
// new column 0 = intercept). NO #[wcet]: n_obs/n_pred are runtime values.
// WCET formula: ~20 + n_obs * (1 + n_pred) * ~5 cycles.
fn linreg_add_intercept(X_flat: ref Vec<f64>, n_obs: i64, n_pred: i64) -> Vec<f64> {
    let out: Vec<f64> = vec();
    let i: i64 = 0;
    while i < n_obs {
        push(mut ref out, 1.0);
        let j: i64 = 0;
        while j < n_pred {
            push(mut ref out, X_flat[i * n_pred + j]);
            j = j + 1;
        }
        i = i + 1;
    }
    return out;
}

// Ordinary least squares fit: beta = (XtX)^-1 Xty. Pass an intercept
// column yourself (see linreg_add_intercept) if you want one -- same
// convention as the underlying probability::mlr_fit.
fn linreg_fit(X_flat: ref Vec<f64>, y: ref Vec<f64>, n_obs: i64, n_pred: i64) -> Vec<f64> {
    return probability::mlr_fit(X_flat, y, n_obs, n_pred);
}

// Predicted values: y_hat = X beta.
fn linreg_predict(X_flat: ref Vec<f64>, beta: ref Vec<f64>, n_obs: i64, n_pred: i64) -> Vec<f64> {
    return probability::mlr_predict(X_flat, beta, n_obs, n_pred);
}

// Coefficient of determination: 1 - SS_res/SS_tot.
fn linreg_r_squared(y: ref Vec<f64>, y_hat: ref Vec<f64>) -> f64 {
    return probability::mlr_r_squared(y, y_hat);
}
