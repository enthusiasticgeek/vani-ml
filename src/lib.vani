// vani-ml — machine learning for vāṇी
//
// See TODO.md for the phase checklist and kosh-index/ROADMAP.md's
// "vani-ml scoping breakdown" for full scope, architecture decisions,
// and per-phase risk notes.
//
// Staged: classical ML (v0.1.0-v0.2.0) first, then an autodiff/neural-net
// engine (v0.3.0+) built on a flat arena (Vec<Node> + i64 child indices),
// the same pattern vani-symbolic uses for its expression tree -- refs are
// passed as explicit mut ref Vec<f64> arguments through the backward pass,
// never captured by a closure (ref-capturing closures are compiler
// path-D, deferred indefinitely; see README.md for the full writeup).
//
// CONVENTION: every X_flat is row-major n_obs x n_pred (or n_obs x n_dim
// for kmeans), matching vani-matrix/vani-probability/vani-tensor's shared
// layout -- row i, column j lives at X_flat[i * n_pred + j].
//
// IMPORTANT -- do NOT reimplement vāṇी compiler builtins already used
// throughout this file: push len vec sqrt exp log tanh f64_sigmoid abs
// seed_rng rand_in_range rand_in_range_f64 vec_swap vec_mean i64_min

// ── Linear regression ────────────────────────────────────────────────────
// Thin wrappers over vani-probability's MLR (ordinary least squares via
// normal equations, probability::mlr_*). probability::mlr_fit's own
// convention is "include an intercept column of 1s yourself if you want
// one" -- linreg_add_intercept below is the one genuinely new piece here,
// removing that boilerplate.

// Prepends a column of 1s to X_flat (n_obs x n_pred -> n_obs x (n_pred+1),
// new column 0 = intercept). NO #[wcet]: n_obs/n_pred are runtime values.
// WCET formula: ~20 + n_obs * (1 + n_pred) * ~5 cycles.
#[bounded_stack(bytes = 136)]
fn linreg_add_intercept(X_flat: ref Vec<f64>, n_obs: i64, n_pred: i64) -> Vec<f64> {
    let out: Vec<f64> = vec();
    let i: i64 = 0;
    while i < n_obs {
        push(mut ref out, 1.0);
        let j: i64 = 0;
        while j < n_pred {
            push(mut ref out, X_flat[i * n_pred + j]);
            j = j + 1;
        }
        i = i + 1;
    }
    return out;
}

// Ordinary least squares fit: beta = (XtX)^-1 Xty. Pass an intercept
// column yourself (see linreg_add_intercept) if you want one -- same
// convention as the underlying probability::mlr_fit.
#[bounded_stack(bytes = 792)]
fn linreg_fit(X_flat: ref Vec<f64>, y: ref Vec<f64>, n_obs: i64, n_pred: i64) -> Vec<f64> {
    return probability::mlr_fit(X_flat, y, n_obs, n_pred);
}

// Predicted values: y_hat = X beta.
#[bounded_stack(bytes = 336)]
fn linreg_predict(X_flat: ref Vec<f64>, beta: ref Vec<f64>, n_obs: i64, n_pred: i64) -> Vec<f64> {
    return probability::mlr_predict(X_flat, beta, n_obs, n_pred);
}

// Coefficient of determination: 1 - SS_res/SS_tot.
#[bounded_stack(bytes = 296)]
fn linreg_r_squared(y: ref Vec<f64>, y_hat: ref Vec<f64>) -> f64 {
    return probability::mlr_r_squared(y, y_hat);
}

// ── Logistic regression ──────────────────────────────────────────────────
// Binary classification via cross-entropy loss + batch gradient descent.
//
// Deliberately NOT built on optimize::gradient_descent_fixed/backtracking:
// their objective/gradient are fixed `fn(ref Vec<f64>, i64) -> f64`
// function pointers with no way to thread the training data (X_flat, y)
// through -- vāṇी closures don't support ref-capturing (see this repo's
// README / kosh-index/ROADMAP.md's "ML tier" section for the full
// writeup). So logreg_fit below has its own small fixed-step loop,
// specialized directly to (X_flat, y, beta) -- same algorithm shape as
// optimize::gradient_descent_fixed, just not routed through its
// fn-pointer interface.

// z = X beta, row by row. No vani-matrix dependency for this -- v0.1.0
// deliberately doesn't declare one (see vani.toml); this is one small
// O(n_obs*n_pred) loop, not worth a whole dependency.
// NO #[wcet]: n_obs/n_pred are runtime values.
// WCET formula: ~20 + n_obs * n_pred * ~5 cycles.
#[bounded_stack(bytes = 160)]
fn _logreg_linear_combo(X_flat: ref Vec<f64>, beta: ref Vec<f64>, n_obs: i64, n_pred: i64) -> Vec<f64> {
    let z: Vec<f64> = vec();
    let i: i64 = 0;
    while i < n_obs {
        let s: f64 = 0.0;
        let j: i64 = 0;
        while j < n_pred {
            s = s + X_flat[i * n_pred + j] * beta[j];
            j = j + 1;
        }
        push(mut ref z, s);
        i = i + 1;
    }
    return z;
}

// Predicted probabilities: sigmoid(X beta).
#[bounded_stack(bytes = 312)]
fn logreg_predict_proba(X_flat: ref Vec<f64>, beta: ref Vec<f64>, n_obs: i64, n_pred: i64) -> Vec<f64> {
    let z: Vec<f64> = _logreg_linear_combo(X_flat, beta, n_obs, n_pred);
    let p: Vec<f64> = vec();
    let i: i64 = 0;
    while i < n_obs {
        push(mut ref p, f64_sigmoid(z[i]));
        i = i + 1;
    }
    return p;
}

// Thresholded 0/1 predictions (threshold typically 0.5).
#[bounded_stack(bytes = 472)]
fn logreg_predict(X_flat: ref Vec<f64>, beta: ref Vec<f64>, n_obs: i64, n_pred: i64, threshold: f64) -> Vec<f64> {
    let p: Vec<f64> = logreg_predict_proba(X_flat, beta, n_obs, n_pred);
    let out: Vec<f64> = vec();
    let i: i64 = 0;
    while i < n_obs {
        if p[i] >= threshold {
            push(mut ref out, 1.0);
        } else {
            push(mut ref out, 0.0);
        }
        i = i + 1;
    }
    return out;
}

// Batch gradient descent on cross-entropy loss:
// grad = (1/n_obs) * X^T (sigmoid(X beta) - y).
// x0 is the starting beta (pass a zero vector of length n_pred if unsure).
// NO #[wcet]: max_iter/n_obs/n_pred are runtime values.
// WCET formula: ~20 + max_iter * O(n_obs * n_pred).
#[bounded_stack(bytes = 592)]
fn logreg_fit(
    X_flat: ref Vec<f64>, y: ref Vec<f64>, n_obs: i64, n_pred: i64,
    x0: ref Vec<f64>, alpha: f64, max_iter: i64
) -> Vec<f64> {
    let beta: Vec<f64> = vec();
    let i0: i64 = 0;
    while i0 < n_pred {
        push(mut ref beta, x0[i0]);
        i0 = i0 + 1;
    }
    let iter: i64 = 0;
    while iter < max_iter {
        let p: Vec<f64> = logreg_predict_proba(X_flat, ref beta, n_obs, n_pred);
        let grad: Vec<f64> = vec();
        let j: i64 = 0;
        while j < n_pred {
            let g: f64 = 0.0;
            let i: i64 = 0;
            while i < n_obs {
                g = g + X_flat[i * n_pred + j] * (p[i] - y[i]);
                i = i + 1;
            }
            push(mut ref grad, g / (n_obs as f64));
            j = j + 1;
        }
        let k: i64 = 0;
        while k < n_pred {
            set(mut ref beta, k, beta[k] - alpha * grad[k]);
            k = k + 1;
        }
        iter = iter + 1;
    }
    return beta;
}

// ── K-means clustering ───────────────────────────────────────────────────
// Lloyd's algorithm. X_flat is row-major n_obs x n_dim. No existing kosh
// package covers this -- genuinely new code, not a wrapper.

struct KMeansResult {
    assignments: Vec<i64>,
    centroids: Vec<f64>,
    n_iter: i64,
}

// Squared Euclidean distance (no sqrt -- unnecessary for nearest-centroid
// comparison or centroid averaging, and avoids the cost everywhere it's
// called in a hot loop).
#[bounded_stack(bytes = 120)]
fn _kmeans_sqdist(X_flat: ref Vec<f64>, row: i64, centroids: ref Vec<f64>, c: i64, n_dim: i64) -> f64 {
    let s: f64 = 0.0;
    let d: i64 = 0;
    while d < n_dim {
        let diff: f64 = X_flat[row * n_dim + d] - centroids[c * n_dim + d];
        s = s + diff * diff;
        d = d + 1;
    }
    return s;
}

#[bounded_stack(bytes = 256)]
fn _kmeans_nearest(X_flat: ref Vec<f64>, row: i64, centroids: ref Vec<f64>, k: i64, n_dim: i64) -> i64 {
    let best: i64 = 0;
    let best_d: f64 = _kmeans_sqdist(X_flat, row, centroids, 0, n_dim);
    let c: i64 = 1;
    while c < k {
        let d: f64 = _kmeans_sqdist(X_flat, row, centroids, c, n_dim);
        if d < best_d {
            best_d = d;
            best = c;
        }
        c = c + 1;
    }
    return best;
}

#[bounded_stack(bytes = 74)]
fn _kmeans_i64_contains(xs: ref Vec<i64>, val: i64) -> bool {
    let n: i64 = len(xs) as i64;
    let i: i64 = 0;
    while i < n {
        if xs[i] == val { return true; }
        i = i + 1;
    }
    return false;
}

// Fits k clusters via Lloyd's algorithm (random-point init, not k-means++
// -- v0.1.0 keeps init simple; revisit if convergence quality on real
// data ever demands it). `seed` makes centroid init deterministic (same
// seed + same data -> same result), matching the compiler's own
// seed_rng/rand_in_range convention. Empty clusters keep their previous
// centroid rather than reinitializing (a documented, common convention;
// avoids a division by zero). Stops early if assignments stop changing.
// NO #[wcet]: max_iter/n_obs/k/n_dim are runtime values, and the initial
// centroid-selection loop retries on duplicate draws (unbounded in the
// worst case, though vanishingly unlikely to loop more than a handful of
// times in practice for k << n_obs).
// WCET formula: ~40 + max_iter * O(n_obs * k * n_dim).
#[bounded_stack(bytes = 755)]
fn kmeans_fit(X_flat: ref Vec<f64>, n_obs: i64, n_dim: i64, k: i64, max_iter: i64, seed: i64) -> KMeansResult {
    let _seeded: i64 = seed_rng(seed as u64);

    let chosen: Vec<i64> = vec();
    while len(ref chosen) as i64 < k {
        let r: i64 = rand_in_range(0, n_obs);
        if !_kmeans_i64_contains(ref chosen, r) {
            push(mut ref chosen, r);
        }
    }
    let centroids: Vec<f64> = vec();
    let ci: i64 = 0;
    while ci < k {
        let row: i64 = chosen[ci];
        let d: i64 = 0;
        while d < n_dim {
            push(mut ref centroids, X_flat[row * n_dim + d]);
            d = d + 1;
        }
        ci = ci + 1;
    }

    let assignments: Vec<i64> = vec();
    let ai: i64 = 0;
    while ai < n_obs {
        push(mut ref assignments, 0);
        ai = ai + 1;
    }

    let iter: i64 = 0;
    let changed: bool = true;
    while iter < max_iter && changed {
        changed = false;
        let new_assignments: Vec<i64> = vec();
        let i: i64 = 0;
        while i < n_obs {
            let nearest: i64 = _kmeans_nearest(X_flat, i, ref centroids, k, n_dim);
            push(mut ref new_assignments, nearest);
            if iter == 0 || nearest != assignments[i] {
                changed = true;
            }
            i = i + 1;
        }
        assignments = new_assignments;

        let sums: Vec<f64> = vec();
        let si: i64 = 0;
        while si < k * n_dim {
            push(mut ref sums, 0.0);
            si = si + 1;
        }
        let counts: Vec<i64> = vec();
        let cti: i64 = 0;
        while cti < k {
            push(mut ref counts, 0);
            cti = cti + 1;
        }
        let j: i64 = 0;
        while j < n_obs {
            let c: i64 = assignments[j];
            let d2: i64 = 0;
            while d2 < n_dim {
                set(mut ref sums, c * n_dim + d2, sums[c * n_dim + d2] + X_flat[j * n_dim + d2]);
                d2 = d2 + 1;
            }
            set(mut ref counts, c, counts[c] + 1);
            j = j + 1;
        }
        let c2: i64 = 0;
        while c2 < k {
            if counts[c2] > 0 {
                let d3: i64 = 0;
                while d3 < n_dim {
                    set(mut ref centroids, c2 * n_dim + d3, sums[c2 * n_dim + d3] / (counts[c2] as f64));
                    d3 = d3 + 1;
                }
            }
            c2 = c2 + 1;
        }
        iter = iter + 1;
    }

    return KMeansResult { assignments: assignments, centroids: centroids, n_iter: iter };
}

// Assigns each row of X_flat to the nearest of an already-fit set of
// centroids (e.g. on new/held-out data).
#[bounded_stack(bytes = 392)]
fn kmeans_predict(X_flat: ref Vec<f64>, centroids: ref Vec<f64>, n_obs: i64, n_dim: i64, k: i64) -> Vec<i64> {
    let out: Vec<i64> = vec();
    let i: i64 = 0;
    while i < n_obs {
        push(mut ref out, _kmeans_nearest(X_flat, i, centroids, k, n_dim));
        i = i + 1;
    }
    return out;
}

// Inertia (within-cluster sum of squared distances to the assigned
// centroid) -- the standard k-means objective value, useful for
// comparing different k or different random inits.
#[bounded_stack(bytes = 232)]
fn kmeans_inertia(X_flat: ref Vec<f64>, assignments: ref Vec<i64>, centroids: ref Vec<f64>, n_obs: i64, n_dim: i64) -> f64 {
    let total: f64 = 0.0;
    let i: i64 = 0;
    while i < n_obs {
        total = total + _kmeans_sqdist(X_flat, i, centroids, assignments[i], n_dim);
        i = i + 1;
    }
    return total;
}

// ── Train/test split ─────────────────────────────────────────────────────

struct TrainTestSplit {
    X_train: Vec<f64>,
    y_train: Vec<f64>,
    X_test: Vec<f64>,
    y_test: Vec<f64>,
    n_train: i64,
    n_test: i64,
}

// Fisher-Yates shuffle of row indices, then splits at the test_frac
// boundary (n_test = truncate(n_obs * test_frac)). `seed` makes the
// split reproducible -- same seed + same data -> same split.
// NO #[wcet]: n_obs/n_dim are runtime values.
// WCET formula: ~30 + n_obs * (1 + n_dim) * ~5 cycles.
#[bounded_stack(bytes = 336)]
fn train_test_split(X_flat: ref Vec<f64>, y: ref Vec<f64>, n_obs: i64, n_dim: i64, test_frac: f64, seed: i64) -> TrainTestSplit {
    let _seeded: i64 = seed_rng(seed as u64);
    let idx: Vec<i64> = vec();
    let i0: i64 = 0;
    while i0 < n_obs {
        push(mut ref idx, i0);
        i0 = i0 + 1;
    }
    let p: i64 = n_obs - 1;
    while p > 0 {
        let r: i64 = rand_in_range(0, p + 1);
        vec_swap(mut ref idx, p, r);
        p = p - 1;
    }

    let n_test: i64 = (test_frac * (n_obs as f64)) as i64;
    let n_train: i64 = n_obs - n_test;

    let X_train: Vec<f64> = vec();
    let y_train: Vec<f64> = vec();
    let X_test: Vec<f64> = vec();
    let y_test: Vec<f64> = vec();

    let j: i64 = 0;
    while j < n_obs {
        let row: i64 = idx[j];
        let d: i64 = 0;
        if j < n_train {
            while d < n_dim {
                push(mut ref X_train, X_flat[row * n_dim + d]);
                d = d + 1;
            }
            push(mut ref y_train, y[row]);
        } else {
            while d < n_dim {
                push(mut ref X_test, X_flat[row * n_dim + d]);
                d = d + 1;
            }
            push(mut ref y_test, y[row]);
        }
        j = j + 1;
    }

    return TrainTestSplit {
        X_train: X_train, y_train: y_train,
        X_test: X_test, y_test: y_test,
        n_train: n_train, n_test: n_test,
    };
}

// ── Core metrics ─────────────────────────────────────────────────────────
// Binary-classification metrics assume labels in {0.0, 1.0}.

#[bounded_stack(bytes = 104)]
fn mse(y_true: ref Vec<f64>, y_pred: ref Vec<f64>) -> f64 {
    let n: i64 = len(y_true) as i64;
    let s: f64 = 0.0;
    let i: i64 = 0;
    while i < n {
        let d: f64 = y_true[i] - y_pred[i];
        s = s + d * d;
        i = i + 1;
    }
    return s / (n as f64);
}

#[bounded_stack(bytes = 96)]
fn accuracy(y_true: ref Vec<f64>, y_pred: ref Vec<f64>) -> f64 {
    let n: i64 = len(y_true) as i64;
    let correct: i64 = 0;
    let i: i64 = 0;
    while i < n {
        if y_true[i] == y_pred[i] { correct = correct + 1; }
        i = i + 1;
    }
    return (correct as f64) / (n as f64);
}

// TP / (TP + FP). Returns 0.0 if no positive predictions were made
// (avoids a division by zero; a defensible convention -- scikit-learn
// does the same with a warning).
#[bounded_stack(bytes = 112)]
fn precision(y_true: ref Vec<f64>, y_pred: ref Vec<f64>) -> f64 {
    let n: i64 = len(y_true) as i64;
    let tp: i64 = 0;
    let fp: i64 = 0;
    let i: i64 = 0;
    while i < n {
        if y_pred[i] == 1.0 {
            if y_true[i] == 1.0 { tp = tp + 1; } else { fp = fp + 1; }
        }
        i = i + 1;
    }
    if tp + fp == 0 { return 0.0; }
    return (tp as f64) / ((tp + fp) as f64);
}

// TP / (TP + FN). Returns 0.0 if there are no actual positives.
#[bounded_stack(bytes = 112)]
fn recall(y_true: ref Vec<f64>, y_pred: ref Vec<f64>) -> f64 {
    let n: i64 = len(y_true) as i64;
    let tp: i64 = 0;
    let fneg: i64 = 0;
    let i: i64 = 0;
    while i < n {
        if y_true[i] == 1.0 {
            if y_pred[i] == 1.0 { tp = tp + 1; } else { fneg = fneg + 1; }
        }
        i = i + 1;
    }
    if tp + fneg == 0 { return 0.0; }
    return (tp as f64) / ((tp + fneg) as f64);
}

// Harmonic mean of precision and recall. Returns 0.0 if both are 0.
#[bounded_stack(bytes = 192)]
fn f1_score(y_true: ref Vec<f64>, y_pred: ref Vec<f64>) -> f64 {
    let p: f64 = precision(y_true, y_pred);
    let r: f64 = recall(y_true, y_pred);
    if p + r < 1.0e-15 { return 0.0; }
    return 2.0 * p * r / (p + r);
}

// ── v0.2.0: Data utilities ───────────────────────────────────────────────
// Feature scaling, one-hot encoding, a Dataset bundle struct, and k-fold
// cross-validation splitting. Scaling uses a fit/apply split (not a
// single all-in-one transform) so a caller can fit on training data and
// apply the SAME parameters to held-out test data -- fitting separately
// on train and test would leak test-set statistics into the transform,
// the standard reason real ML libraries split it this way too.
// Cross-validation here means SPLITTING (k_fold_split, mirroring
// train_test_split's own scope), not a full train/eval harness: this
// package has no generic "trainable model" abstraction (linreg/logreg/
// kmeans each have distinct fit signatures), so a caller loops over
// k_fold_split's `fold` parameter themselves and calls whichever model's
// fit/predict they want per iteration -- same "caller loops themselves,
// no closures needed" convention as vani-vectorcalc's line integrals.

// Per-column mean and standard deviation (population, i.e. divided by
// n_obs not n_obs-1, since this is a data-preprocessing statistic, not a
// sample-variance estimate) from a fit pass over X_flat, reusable via
// standardize_apply on any data with the same n_dim (e.g. a held-out test
// set, using the TRAINING set's stats).
struct StandardScaler {
    means: Vec<f64>,
    stds: Vec<f64>,
}

// WCET formula: ~20 + n_obs * n_dim * ~10 cycles (two passes over the
// data). NO #[wcet]: n_obs/n_dim are runtime values.
#[bounded_stack(bytes = 240)]
fn standardize_fit(X_flat: ref Vec<f64>, n_obs: i64, n_dim: i64) -> StandardScaler {
    let means: Vec<f64> = vec();
    let d0: i64 = 0;
    while d0 < n_dim {
        let s: f64 = 0.0;
        let i0: i64 = 0;
        while i0 < n_obs {
            s = s + X_flat[i0 * n_dim + d0];
            i0 = i0 + 1;
        }
        push(mut ref means, s / (n_obs as f64));
        d0 = d0 + 1;
    }
    let stds: Vec<f64> = vec();
    let d1: i64 = 0;
    while d1 < n_dim {
        let ss: f64 = 0.0;
        let i1: i64 = 0;
        while i1 < n_obs {
            let dev: f64 = X_flat[i1 * n_dim + d1] - means[d1];
            ss = ss + dev * dev;
            i1 = i1 + 1;
        }
        push(mut ref stds, sqrt(ss / (n_obs as f64)));
        d1 = d1 + 1;
    }
    return StandardScaler { means: means, stds: stds };
}

// Applies a fitted StandardScaler: out[i,d] = (X[i,d] - mean[d]) /
// std[d]. A constant column (std ~ 0) is only centered, not scaled (dividing
// by ~0 would blow up to +-inf for a column that carries no variance
// information anyway) -- same guard convention as this package's own
// weighted_variance-style near-zero-denominator checks elsewhere in the
// Kosh ecosystem (see vani-probability's weighted_variance).
// WCET formula: ~20 + n_obs * n_dim * ~10 cycles.
#[bounded_stack(bytes = 160)]
fn standardize_apply(X_flat: ref Vec<f64>, n_obs: i64, n_dim: i64, scaler: ref StandardScaler) -> Vec<f64> {
    let out: Vec<f64> = vec();
    let i: i64 = 0;
    while i < n_obs {
        let d: i64 = 0;
        while d < n_dim {
            let dev: f64 = X_flat[i * n_dim + d] - scaler.means[d];
            if scaler.stds[d] < 1.0e-15 {
                push(mut ref out, dev);
            } else {
                push(mut ref out, dev / scaler.stds[d]);
            }
            d = d + 1;
        }
        i = i + 1;
    }
    return out;
}

// Per-column min and max from a fit pass over X_flat, reusable via
// normalize_apply on any data with the same n_dim (same train/test
// rationale as StandardScaler).
struct MinMaxScaler {
    mins: Vec<f64>,
    maxs: Vec<f64>,
}

// WCET formula: ~20 + n_obs * n_dim * ~10 cycles.
#[bounded_stack(bytes = 232)]
fn normalize_fit(X_flat: ref Vec<f64>, n_obs: i64, n_dim: i64) -> MinMaxScaler {
    let mins: Vec<f64> = vec();
    let maxs: Vec<f64> = vec();
    let d: i64 = 0;
    while d < n_dim {
        let mn: f64 = X_flat[d];
        let mx: f64 = X_flat[d];
        let i: i64 = 1;
        while i < n_obs {
            let v: f64 = X_flat[i * n_dim + d];
            if v < mn { mn = v; }
            if v > mx { mx = v; }
            i = i + 1;
        }
        push(mut ref mins, mn);
        push(mut ref maxs, mx);
        d = d + 1;
    }
    return MinMaxScaler { mins: mins, maxs: maxs };
}

// Applies a fitted MinMaxScaler: out[i,d] = (X[i,d] - min[d]) /
// (max[d] - min[d]), mapping the FIT data's own range to [0,1] (data
// scaled from a different range, e.g. a test set with values outside the
// training range, can land outside [0,1] -- expected, not a bug). A
// constant column (max ~ min) maps to 0.0 everywhere rather than dividing
// by ~0.
// WCET formula: ~20 + n_obs * n_dim * ~10 cycles.
#[bounded_stack(bytes = 168)]
fn normalize_apply(X_flat: ref Vec<f64>, n_obs: i64, n_dim: i64, scaler: ref MinMaxScaler) -> Vec<f64> {
    let out: Vec<f64> = vec();
    let i: i64 = 0;
    while i < n_obs {
        let d: i64 = 0;
        while d < n_dim {
            let range: f64 = scaler.maxs[d] - scaler.mins[d];
            if range < 1.0e-15 {
                push(mut ref out, 0.0);
            } else {
                push(mut ref out, (X_flat[i * n_dim + d] - scaler.mins[d]) / range);
            }
            d = d + 1;
        }
        i = i + 1;
    }
    return out;
}

// One-hot encoding: row-major (len(labels) x n_classes) Vec<f64>, a 1.0
// at each row's label index and 0.0 elsewhere. Caller-trust: every label
// in [0, n_classes) -- not checked at runtime, same convention as every
// other unenforced range assumption in this ecosystem.
// WCET formula: ~20 + len(labels) * n_classes * ~5 cycles.
#[bounded_stack(bytes = 152)]
fn one_hot_encode(labels: ref Vec<i64>, n_classes: i64) -> Vec<f64> {
    let n: i64 = len(labels) as i64;
    let out: Vec<f64> = vec();
    let i: i64 = 0;
    while i < n {
        let c: i64 = 0;
        while c < n_classes {
            if c == labels[i] {
                push(mut ref out, 1.0);
            } else {
                push(mut ref out, 0.0);
            }
            c = c + 1;
        }
        i = i + 1;
    }
    return out;
}

// Bundles a feature matrix and its labels together, matching vani-matrix/
// vani-tensor's row-major convention (this package's own CONVENTION note
// at the top of the file). A thin bundle, not a new abstraction -- lets
// k_fold_split (and any future function that composes multiple datasets)
// take/return one value instead of four.
struct Dataset {
    X_flat: Vec<f64>,
    y: Vec<f64>,
    n_obs: i64,
    n_dim: i64,
}

// One fold's train/test partition, same shape as TrainTestSplit.
struct KFoldSplit {
    X_train: Vec<f64>,
    y_train: Vec<f64>,
    n_train: i64,
    X_test: Vec<f64>,
    y_test: Vec<f64>,
    n_test: i64,
}

// k-fold split: partitions X_flat/y into k roughly-equal folds (any
// remainder from n_obs not dividing evenly by k is distributed one-per-
// fold across the first `n_obs % k` folds, so fold sizes differ by at
// most 1) via the same seeded Fisher-Yates shuffle as train_test_split,
// then returns fold `fold`'s test partition (that fold) and train
// partition (every other fold). Calling this k times with fold=0..k-1
// and the SAME seed reproduces the identical underlying shuffle each
// time (seed_rng fully resets the RNG state), so the k folds are a
// genuine partition of the data across those calls, not k independent
// random subsets. `fold` must be in [0, k).
// NO #[wcet]: n_obs/n_dim/k are runtime values.
// WCET formula: ~30 + n_obs * (1 + n_dim) * ~5 cycles, same order as
// train_test_split.
#[bounded_stack(bytes = 400)]
fn k_fold_split(X_flat: ref Vec<f64>, y: ref Vec<f64>, n_obs: i64, n_dim: i64, k: i64, fold: i64, seed: i64) -> KFoldSplit {
    assert fold >= 0 && fold < k;
    let _seeded: i64 = seed_rng(seed as u64);
    let idx: Vec<i64> = vec();
    let i0: i64 = 0;
    while i0 < n_obs {
        push(mut ref idx, i0);
        i0 = i0 + 1;
    }
    let p: i64 = n_obs - 1;
    while p > 0 {
        let r: i64 = rand_in_range(0, p + 1);
        vec_swap(mut ref idx, p, r);
        p = p - 1;
    }

    let base: i64 = n_obs / k;
    let rem: i64 = n_obs % k;
    let fold_size: i64 = base;
    if fold < rem {
        fold_size = base + 1;
    }
    let start: i64 = fold * base + i64_min(fold, rem);
    let end: i64 = start + fold_size;

    let X_train: Vec<f64> = vec();
    let y_train: Vec<f64> = vec();
    let X_test: Vec<f64> = vec();
    let y_test: Vec<f64> = vec();
    let n_train: i64 = 0;
    let n_test: i64 = 0;

    let j: i64 = 0;
    while j < n_obs {
        let row: i64 = idx[j];
        let d: i64 = 0;
        if j >= start && j < end {
            while d < n_dim {
                push(mut ref X_test, X_flat[row * n_dim + d]);
                d = d + 1;
            }
            push(mut ref y_test, y[row]);
            n_test = n_test + 1;
        } else {
            while d < n_dim {
                push(mut ref X_train, X_flat[row * n_dim + d]);
                d = d + 1;
            }
            push(mut ref y_train, y[row]);
            n_train = n_train + 1;
        }
        j = j + 1;
    }

    return KFoldSplit {
        X_train: X_train, y_train: y_train, n_train: n_train,
        X_test: X_test, y_test: y_test, n_test: n_test,
    };
}

// ── v0.3.0: Autodiff core (computation graph) ───────────────────────────────
//
// ENCODING: flat arena, same "Vec<Node> + i64 child indices, kind-tag
// dispatch" workaround vani-symbolic uses for its expression tree (a
// recursive enum doesn't compile in vāṇी today -- see vani-symbolic's own
// header comment for the full rationale). GraphNode is Copy (four
// fields, no heap-owning field), matching ExprNode's own precedent.
//
//   struct GraphNode { kind: i64, value: f64, left: i64, right: i64 }
//
// kind tags: 0=Const 1=Param 2=Add 3=Sub 4=Mul 5=Div 6=Neg
//
// DEPARTURE from vani-symbolic's pattern: no symbol table. Expression
// trees are parsed from named variables that can be referenced from
// multiple places by name; autodiff graphs are never parsed -- they're
// built directly via function calls, so a caller who wants to reuse a
// value just reuses the i64 index graph_param/graph_const already
// returned them (e.g. `let x: i64 = graph_param(mut ref arena, 1.0);
// let y: i64 = graph_mul(mut ref arena, x, x);` -- same `x` passed
// twice). This means the SAME arena index can legitimately be two
// different nodes' child -- a real DAG, not just a tree -- which is
// exactly the case reverse-mode autodiff must handle correctly (a value
// used twice must receive the SUM of both paths' gradient
// contributions, not just one).
//
// NO RECURSION, NO TOPOLOGICAL SORT NEEDED: because the arena is
// append-only and a node's left/right children must already exist
// (lower indices) before the node referencing them can be constructed,
// arena indices are already in topological order by construction.
// graph_forward is a single ascending loop (each node's value depends
// only on already-computed lower-index values); graph_backward is a
// single DESCENDING loop seeded with grads[root]=1.0 (by the time node
// i is processed, every possible consumer of node i -- which must have
// a strictly higher index -- has already run and already added its
// contribution to grads[i] via +=, so grads[i] is guaranteed final the
// moment node i's own backward step runs). This is the standard
// reverse-mode-AD algorithm (same one micrograd/PyTorch's tape-based
// autograd use); the append-only arena gets the correct traversal order
// for free, no separate topo-sort pass needed.
//
// Const vs. Param: functionally identical to both passes (both are
// leaves: forward returns the stored value, backward doesn't propagate
// further) -- kept as separate tags purely so a caller can tell which
// leaf indices are meant to be read back out of grads[] afterward.
// graph_set_value only accepts Param (asserts kind==1), the hook a
// future optimizer step will call between training iterations.
//
// Pow is deliberately NOT included in this phase: `f(x) = x*x` (the
// SAME arena index passed as both graph_mul operands) already exercises
// the DAG/shared-node accumulation case (d(x*x)/dx = 2x) without
// needing a dedicated kind. Activations/losses are explicitly v0.4.0
// scope, not added here.
//
// WCET (MAINT-1 discipline, see kosh-index/ROADMAP.md): every
// #[wcet(cycles=N)] below is vanic check's own exact reported worst-case,
// never hand-derived. The 9 fixed-shape construction/mutation functions
// get a real #[wcet]; graph_forward/graph_backward are Vec-length-loop-
// bounded (a runtime value, same as vani-symbolic's sym_eval) and get a
// WCET *formula* comment instead.

struct GraphNode {
    kind: i64,
    value: f64,
    left: i64,
    right: i64,
}

// ── Construction ─────────────────────────────────────────────────────────

#[bounded_stack(bytes = 56)]
#[wcet(cycles = 85)]
fn graph_arena_new() -> Vec<GraphNode> {
    return vec();
}

#[bounded_stack(bytes = 56)]
#[wcet(cycles = 36)]
fn graph_const(arena: mut ref Vec<GraphNode>, v: f64) -> i64 {
    push(arena, GraphNode { kind: 0, value: v, left: 0 - 1, right: 0 - 1 });
    return (len(arena) as i64) - 1;
}

#[bounded_stack(bytes = 56)]
#[wcet(cycles = 36)]
fn graph_param(arena: mut ref Vec<GraphNode>, v: f64) -> i64 {
    push(arena, GraphNode { kind: 1, value: v, left: 0 - 1, right: 0 - 1 });
    return (len(arena) as i64) - 1;
}

#[bounded_stack(bytes = 64)]
#[wcet(cycles = 60)]
fn graph_add(arena: mut ref Vec<GraphNode>, a: i64, b: i64) -> i64 {
    assert a >= 0 && a < (len(arena) as i64);
    assert b >= 0 && b < (len(arena) as i64);
    push(arena, GraphNode { kind: 2, value: 0.0, left: a, right: b });
    return (len(arena) as i64) - 1;
}

#[bounded_stack(bytes = 64)]
#[wcet(cycles = 60)]
fn graph_sub(arena: mut ref Vec<GraphNode>, a: i64, b: i64) -> i64 {
    assert a >= 0 && a < (len(arena) as i64);
    assert b >= 0 && b < (len(arena) as i64);
    push(arena, GraphNode { kind: 3, value: 0.0, left: a, right: b });
    return (len(arena) as i64) - 1;
}

#[bounded_stack(bytes = 64)]
#[wcet(cycles = 60)]
fn graph_mul(arena: mut ref Vec<GraphNode>, a: i64, b: i64) -> i64 {
    assert a >= 0 && a < (len(arena) as i64);
    assert b >= 0 && b < (len(arena) as i64);
    push(arena, GraphNode { kind: 4, value: 0.0, left: a, right: b });
    return (len(arena) as i64) - 1;
}

#[bounded_stack(bytes = 64)]
#[wcet(cycles = 60)]
fn graph_div(arena: mut ref Vec<GraphNode>, a: i64, b: i64) -> i64 {
    assert a >= 0 && a < (len(arena) as i64);
    assert b >= 0 && b < (len(arena) as i64);
    push(arena, GraphNode { kind: 5, value: 0.0, left: a, right: b });
    return (len(arena) as i64) - 1;
}

// Unary: right stays -1, arity is a pure function of kind (never stored
// per-node), matching vani-symbolic's Neg convention exactly.
#[bounded_stack(bytes = 56)]
#[wcet(cycles = 48)]
fn graph_neg(arena: mut ref Vec<GraphNode>, a: i64) -> i64 {
    assert a >= 0 && a < (len(arena) as i64);
    push(arena, GraphNode { kind: 6, value: 0.0, left: a, right: 0 - 1 });
    return (len(arena) as i64) - 1;
}

// Mutates a Param leaf's stored value in place -- the hook a future
// optimizer step calls between training iterations. Asserts Param, not
// Const: mutating what's meant to be a fixed constant is a caller bug.
#[bounded_stack(bytes = 96)]
#[wcet(cycles = 68)]
fn graph_set_value(arena: mut ref Vec<GraphNode>, idx: i64, v: f64) -> i64 {
    assert idx >= 0 && idx < (len(arena) as i64);
    assert arena[idx].kind == 1;
    let node: GraphNode = arena[idx];
    set(arena, idx, GraphNode { kind: node.kind, value: v, left: node.left, right: node.right });
    return 0;
}

// ── Forward / backward passes ────────────────────────────────────────────

// Evaluates every node 0..n-1 in index order (children always have a
// lower index than their parent, so this single ascending pass is
// always correct regardless of which node is the eventual "root").
// Returns the full tape -- graph_backward needs every node's value, not
// just the root's, to compute local derivatives (e.g. d(mul)/d(left) =
// right's value).
// NO #[wcet]: len(arena) is a runtime value.
// WCET formula: ~25 * (number of nodes in the arena).
#[bounded_stack(bytes = 160)]
fn graph_forward(arena: ref Vec<GraphNode>) -> Vec<f64> {
    let n: i64 = len(arena) as i64;
    let values: Vec<f64> = vec();
    let i: i64 = 0;
    while i < n {
        let node: GraphNode = arena[i];
        let v: f64 = 0.0;
        if node.kind == 0 {
            v = node.value;
        } else if node.kind == 1 {
            v = node.value;
        } else if node.kind == 2 {
            v = values[node.left] + values[node.right];
        } else if node.kind == 3 {
            v = values[node.left] - values[node.right];
        } else if node.kind == 4 {
            v = values[node.left] * values[node.right];
        } else if node.kind == 5 {
            assert values[node.right] != 0.0;
            v = values[node.left] / values[node.right];
        } else if node.kind == 6 {
            v = 0.0 - values[node.left];
        } else if node.kind == 7 {
            if values[node.left] > 0.0 {
                v = values[node.left];
            } else {
                v = 0.0;
            }
        } else if node.kind == 8 {
            v = f64_sigmoid(values[node.left]);
        } else if node.kind == 9 {
            v = tanh(values[node.left]);
        } else {
            assert values[node.left] > 0.0;
            v = log(values[node.left]);
        }
        push(mut ref values, v);
        i = i + 1;
    }
    return values;
}

// Reverse-mode backward pass: returns a fresh grads: Vec<f64> (length
// len(arena)), all zero except at `root` (seeded to 1.0), accumulated by
// a single descending scan -- see this function's section header
// comment above for why descending-index order alone guarantees each
// node's incoming gradient is final before its own backward step runs.
// NO #[wcet]: len(arena) is a runtime value.
// WCET formula: ~30 * (number of nodes in the arena).
#[bounded_stack(bytes = 200)]
fn graph_backward(arena: ref Vec<GraphNode>, values: ref Vec<f64>, root: i64) -> Vec<f64> {
    let n: i64 = len(arena) as i64;
    assert root >= 0 && root < n;
    let grads: Vec<f64> = vec();
    let z: i64 = 0;
    while z < n {
        push(mut ref grads, 0.0);
        z = z + 1;
    }
    set(mut ref grads, root, 1.0);

    let i: i64 = n - 1;
    while i >= 0 {
        let node: GraphNode = arena[i];
        let g: f64 = grads[i];
        if node.kind == 2 {
            set(mut ref grads, node.left, grads[node.left] + g);
            set(mut ref grads, node.right, grads[node.right] + g);
        } else if node.kind == 3 {
            set(mut ref grads, node.left, grads[node.left] + g);
            set(mut ref grads, node.right, grads[node.right] - g);
        } else if node.kind == 4 {
            set(mut ref grads, node.left, grads[node.left] + g * values[node.right]);
            set(mut ref grads, node.right, grads[node.right] + g * values[node.left]);
        } else if node.kind == 5 {
            let rv: f64 = values[node.right];
            set(mut ref grads, node.left, grads[node.left] + g / rv);
            set(mut ref grads, node.right, grads[node.right] + g * (0.0 - values[node.left]) / (rv * rv));
        } else if node.kind == 6 {
            set(mut ref grads, node.left, grads[node.left] - g);
        } else if node.kind == 7 {
            let relu_deriv: f64 = 0.0;
            if values[node.left] > 0.0 {
                relu_deriv = 1.0;
            }
            set(mut ref grads, node.left, grads[node.left] + g * relu_deriv);
        } else if node.kind == 8 {
            let sv: f64 = values[i];
            set(mut ref grads, node.left, grads[node.left] + g * sv * (1.0 - sv));
        } else if node.kind == 9 {
            let tv: f64 = values[i];
            set(mut ref grads, node.left, grads[node.left] + g * (1.0 - tv * tv));
        } else if node.kind == 10 {
            set(mut ref grads, node.left, grads[node.left] + g / values[node.left]);
        }
        // kind 0 (Const) / 1 (Param): leaf, no children to propagate to.
        i = i - 1;
    }
    return grads;
}

// ── v0.4.0: Layers, activations, losses ──────────────────────────────────
//
// New unary node kinds: 7=Relu 8=Sigmoid 9=Tanh 10=Log -- each takes one
// child (right stays -1, same convention as Neg). graph_forward/
// graph_backward above already had their kind-dispatch structured as a
// chain of if/else-if branches specifically so adding a kind here means
// extending that chain, not restructuring it.
//
// Sigmoid/Tanh's backward rules reuse the ALREADY-COMPUTED forward value
// (values[i] IS sigmoid(x) / tanh(x) by the time backward runs) rather
// than recomputing sigmoid(x)*(1-sigmoid(x)) from x itself -- avoids a
// redundant f64_sigmoid/tanh call and matches how Mul/Div already reuse
// `values[node.left]`/`values[node.right]` instead of re-deriving them.
//
// Log's forward pass asserts values[left] > 0.0, matching this
// ecosystem's "assert on out-of-scope input" convention (e.g.
// bn_div_mod's nonzero-divisor assert) -- log(x) for x<=0 is undefined,
// not a case to silently propagate a NaN through.
//
// Softmax is deliberately NOT added: it's inherently a multi-output op
// (every output depends on every input in its group), a structural
// mismatch with this one-node-one-scalar design without a real
// extension (vector-valued nodes) this phase doesn't need. This
// package's classification support has always been binary only (see
// v0.1.0's logreg_*, cross-entropy loss below is the same binary form,
// sigmoid not softmax) -- multi-class support is a real future phase,
// not silently dropped scope.

#[bounded_stack(bytes = 56)]
#[wcet(cycles = 48)]
fn graph_relu(arena: mut ref Vec<GraphNode>, a: i64) -> i64 {
    assert a >= 0 && a < (len(arena) as i64);
    push(arena, GraphNode { kind: 7, value: 0.0, left: a, right: 0 - 1 });
    return (len(arena) as i64) - 1;
}

#[bounded_stack(bytes = 56)]
#[wcet(cycles = 48)]
fn graph_sigmoid(arena: mut ref Vec<GraphNode>, a: i64) -> i64 {
    assert a >= 0 && a < (len(arena) as i64);
    push(arena, GraphNode { kind: 8, value: 0.0, left: a, right: 0 - 1 });
    return (len(arena) as i64) - 1;
}

#[bounded_stack(bytes = 56)]
#[wcet(cycles = 48)]
fn graph_tanh(arena: mut ref Vec<GraphNode>, a: i64) -> i64 {
    assert a >= 0 && a < (len(arena) as i64);
    push(arena, GraphNode { kind: 9, value: 0.0, left: a, right: 0 - 1 });
    return (len(arena) as i64) - 1;
}

#[bounded_stack(bytes = 56)]
#[wcet(cycles = 48)]
fn graph_log(arena: mut ref Vec<GraphNode>, a: i64) -> i64 {
    assert a >= 0 && a < (len(arena) as i64);
    push(arena, GraphNode { kind: 10, value: 0.0, left: a, right: 0 - 1 });
    return (len(arena) as i64) - 1;
}

// Dense/linear layer: dot(inputs, weights) + bias, built by composing
// EXISTING graph_mul/graph_add calls rather than adding a dedicated
// "Dense" node kind -- matmul emerges naturally from scalar-op
// composition, matching how MSE/cross-entropy below are also built from
// primitives rather than new kinds. `inputs`/`weights` are parallel
// arrays of arena indices (already-constructed Param/Const/expression
// nodes), same length; `bias` is a single arena index (typically a
// Param).
// NO #[wcet]: len(inputs) is a runtime value.
// WCET formula: ~20 + len(inputs) * (2 * graph_mul's 60 + graph_add's 60).
#[bounded_stack(bytes = 184)]
fn graph_dense(arena: mut ref Vec<GraphNode>, inputs: ref Vec<i64>, weights: ref Vec<i64>, bias: i64) -> i64 {
    let n: i64 = len(inputs) as i64;
    assert n == (len(weights) as i64);
    assert n > 0;
    let sum: i64 = graph_mul(arena, inputs[0], weights[0]);
    let i: i64 = 1;
    while i < n {
        let term: i64 = graph_mul(arena, inputs[i], weights[i]);
        sum = graph_add(arena, sum, term);
        i = i + 1;
    }
    return graph_add(arena, sum, bias);
}

// Mean squared error loss: mean((preds[i] - targets[i])^2), built the
// same "compose from primitives" way as graph_dense. `preds` are arena
// indices (typically graph_dense's output, fed through an activation);
// `targets` are plain f64 (ground-truth labels, wrapped in graph_const
// internally -- a target is never itself a trainable Param).
// NO #[wcet]: len(preds) is a runtime value.
// WCET formula: ~20 + len(preds) * (graph_const's 36 + graph_sub's 60 +
// graph_mul's 60 + graph_add's 60).
#[bounded_stack(bytes = 216)]
fn graph_mse_loss(arena: mut ref Vec<GraphNode>, preds: ref Vec<i64>, targets: ref Vec<f64>) -> i64 {
    let n: i64 = len(preds) as i64;
    assert n == (len(targets) as i64);
    assert n > 0;
    let t0: i64 = graph_const(arena, targets[0]);
    let d0: i64 = graph_sub(arena, preds[0], t0);
    let sum: i64 = graph_mul(arena, d0, d0);
    let i: i64 = 1;
    while i < n {
        let ti: i64 = graph_const(arena, targets[i]);
        let di: i64 = graph_sub(arena, preds[i], ti);
        let sq: i64 = graph_mul(arena, di, di);
        sum = graph_add(arena, sum, sq);
        i = i + 1;
    }
    let inv_n: i64 = graph_const(arena, 1.0 / (n as f64));
    return graph_mul(arena, sum, inv_n);
}

// One example's contribution to binary cross-entropy:
// y*log(p) + (1-y)*log(1-p). Factored out of graph_binary_cross_entropy_
// loss below purely to keep that function's own loop body short --
// still just primitive-op composition, not a new node kind.
#[bounded_stack(bytes = 192)]
#[wcet(cycles = 512)]
fn _graph_bce_term(arena: mut ref Vec<GraphNode>, pred: i64, target: f64, one: i64) -> i64 {
    let y: i64 = graph_const(arena, target);
    let one_minus_y: i64 = graph_sub(arena, one, y);
    let log_p: i64 = graph_log(arena, pred);
    let one_minus_p: i64 = graph_sub(arena, one, pred);
    let log_1mp: i64 = graph_log(arena, one_minus_p);
    let term1: i64 = graph_mul(arena, y, log_p);
    let term2: i64 = graph_mul(arena, one_minus_y, log_1mp);
    return graph_add(arena, term1, term2);
}

// Binary cross-entropy loss: -mean(y*log(p) + (1-y)*log(1-p)). `preds`
// are arena indices already passed through graph_sigmoid (p must be in
// (0,1) for graph_log's domain guard); `targets` are plain f64 labels in
// {0.0, 1.0}, same convention as this package's existing logreg_* API.
// NO #[wcet]: len(preds) is a runtime value.
// WCET formula: ~30 + len(preds) * _graph_bce_term's ~350.
#[bounded_stack(bytes = 328)]
fn graph_binary_cross_entropy_loss(arena: mut ref Vec<GraphNode>, preds: ref Vec<i64>, targets: ref Vec<f64>) -> i64 {
    let n: i64 = len(preds) as i64;
    assert n == (len(targets) as i64);
    assert n > 0;
    let one: i64 = graph_const(arena, 1.0);
    let sum: i64 = _graph_bce_term(arena, preds[0], targets[0], one);
    let i: i64 = 1;
    while i < n {
        let term: i64 = _graph_bce_term(arena, preds[i], targets[i], one);
        sum = graph_add(arena, sum, term);
        i = i + 1;
    }
    let inv_n: i64 = graph_const(arena, 1.0 / (n as f64));
    let mean: i64 = graph_mul(arena, sum, inv_n);
    return graph_neg(arena, mean);
}

// ── v0.5.0: Optimizers over the graph's parameter vector ────────────────
//
// `params: ref Vec<i64>` is the list of arena indices a caller wants
// trained (must all be Param leaves -- graph_set_value already asserts
// that per-index). `grads: ref Vec<f64>` is graph_backward's own output,
// indexed by arena index (NOT by position in `params`) -- exactly what
// backward already returns, no repacking needed at the call site.
//
// MomentumState/AdamState hold per-parameter running state (velocity, or
// the first/second moment estimates + step count) INDEXED BY POSITION IN
// `params`, not by arena index -- a caller with e.g. 3 trainable params
// scattered across a 50-node arena gets a 3-element state, not a
// 50-element one wasting space on non-trained nodes.
//
// Each step function returns a FRESH state struct rather than mutating
// one in place, matching this file's own dominant convention
// (KMeansResult/TrainTestSplit/KFoldSplit are all constructed once and
// returned, never mutated after) -- also sidesteps needing direct
// struct-field-assignment syntax (`state.t = state.t + 1`), which has no
// precedent anywhere in this ecosystem's existing code to confirm works;
// `MomentumState { velocity: new_velocity }`/`AdamState { m: new_m, v:
// new_v, t: t_new }` construction is the same pattern every constructor
// in this file already uses successfully.
//
// vani-optimize's existing solvers (gradient_descent_fixed/backtracking)
// don't fit here -- their objective/gradient are a fixed
// `fn(ref Vec<f64>, i64) -> f64` signature built for a flat parameter
// Vec, not a per-graph-node gradient sparse over a much larger arena;
// same "new code, same underlying math, not a straight reuse" situation
// this package's own logreg_fit already documented for v0.1.0.

// Plain SGD: param -= lr * grad. Stateless (no momentum/moment
// estimates), so no state struct needed.
// NO #[wcet]: len(params) is a runtime value.
// WCET formula: ~20 + len(params) * (graph_set_value's 68 + ~10).
#[bounded_stack(bytes = 248)]
fn graph_sgd_step(arena: mut ref Vec<GraphNode>, params: ref Vec<i64>, grads: ref Vec<f64>, lr: f64) -> i64 {
    let n: i64 = len(params) as i64;
    let i: i64 = 0;
    while i < n {
        let idx: i64 = params[i];
        let node: GraphNode = arena[idx];
        let new_val: f64 = node.value - lr * grads[idx];
        let _s: i64 = graph_set_value(arena, idx, new_val);
        i = i + 1;
    }
    return 0;
}

struct MomentumState {
    velocity: Vec<f64>,
}

// Zero-initialized momentum state for `n_params` trainable parameters
// (same length as the `params` Vec a caller will pass to
// graph_momentum_step, NOT the arena's own length).
#[bounded_stack(bytes = 112)]
fn momentum_state_new(n_params: i64) -> MomentumState {
    let velocity: Vec<f64> = vec();
    let i: i64 = 0;
    while i < n_params {
        push(mut ref velocity, 0.0);
        i = i + 1;
    }
    return MomentumState { velocity: velocity };
}

// Classical momentum: v = beta*v - lr*grad; param += v. `beta` is
// typically ~0.9 (fraction of the previous step's velocity retained).
// NO #[wcet]: len(params) is a runtime value.
// WCET formula: ~20 + len(params) * (graph_set_value's 68 + ~15).
#[bounded_stack(bytes = 320)]
fn graph_momentum_step(arena: mut ref Vec<GraphNode>, params: ref Vec<i64>, grads: ref Vec<f64>, state: ref MomentumState, lr: f64, beta: f64) -> MomentumState {
    let n: i64 = len(params) as i64;
    let new_velocity: Vec<f64> = vec();
    let i: i64 = 0;
    while i < n {
        let idx: i64 = params[i];
        let v_new: f64 = beta * state.velocity[i] - lr * grads[idx];
        push(mut ref new_velocity, v_new);
        let node: GraphNode = arena[idx];
        let updated: f64 = node.value + v_new;
        let _s: i64 = graph_set_value(arena, idx, updated);
        i = i + 1;
    }
    return MomentumState { velocity: new_velocity };
}

struct AdamState {
    m: Vec<f64>,
    v: Vec<f64>,
    t: i64,
}

// Zero-initialized Adam state for `n_params` trainable parameters, step
// counter t=0 (graph_adam_step increments it internally on the FIRST
// call, so bias correction is against t=1, not t=0 -- 1 - beta^0 = 0
// would divide by zero).
#[bounded_stack(bytes = 160)]
fn adam_state_new(n_params: i64) -> AdamState {
    let m: Vec<f64> = vec();
    let v: Vec<f64> = vec();
    let i: i64 = 0;
    while i < n_params {
        push(mut ref m, 0.0);
        push(mut ref v, 0.0);
        i = i + 1;
    }
    return AdamState { m: m, v: v, t: 0 };
}

// Adam: bias-corrected running estimates of the gradient's mean (m) and
// uncentered variance (v), standard defaults beta1=0.9, beta2=0.999,
// eps=1e-8 (a caller-supplied param here, not hardcoded, so a test can
// use a larger eps if a param's true v_hat could legitimately be ~0).
// NO #[wcet]: len(params) is a runtime value.
// WCET formula: ~30 + len(params) * (graph_set_value's 68 + ~35).
#[bounded_stack(bytes = 424)]
fn graph_adam_step(arena: mut ref Vec<GraphNode>, params: ref Vec<i64>, grads: ref Vec<f64>, state: ref AdamState, lr: f64, beta1: f64, beta2: f64, eps: f64) -> AdamState {
    let t_new: i64 = state.t + 1;
    let t_f: f64 = t_new as f64;
    let bias_correction1: f64 = 1.0 - pow(beta1, t_f);
    let bias_correction2: f64 = 1.0 - pow(beta2, t_f);
    let n: i64 = len(params) as i64;
    let new_m: Vec<f64> = vec();
    let new_v: Vec<f64> = vec();
    let i: i64 = 0;
    while i < n {
        let idx: i64 = params[i];
        let g: f64 = grads[idx];
        let m_new: f64 = beta1 * state.m[i] + (1.0 - beta1) * g;
        let v_new: f64 = beta2 * state.v[i] + (1.0 - beta2) * g * g;
        push(mut ref new_m, m_new);
        push(mut ref new_v, v_new);
        let m_hat: f64 = m_new / bias_correction1;
        let v_hat: f64 = v_new / bias_correction2;
        let node: GraphNode = arena[idx];
        let updated: f64 = node.value - lr * m_hat / (sqrt(v_hat) + eps);
        let _s: i64 = graph_set_value(arena, idx, updated);
        i = i + 1;
    }
    return AdamState { m: new_m, v: new_v, t: t_new };
}
